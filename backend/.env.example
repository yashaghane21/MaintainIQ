# ---- MaintainIQ backend configuration (copy to .env; never commit real secrets) ----
APP_ENV=development            # development | production | test
LOG_LEVEL=INFO

# Database: "mongo" for MongoDB/Atlas, "memory" for a NON-persistent in-process mock
DB_BACKEND=mongo
MONGODB_URI=mongodb://localhost:27017
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=maintainiq

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider: "gemini" (live) or "demo" (deterministic, clearly labelled as simulated)
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60

# Retrieval embeddings: "auto" (sentence-transformers if installed, else hashing),
# "sentence-transformers" (semantic) or "hashing" (lightweight lexical fallback)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Vector store: "auto" (ChromaDB if installed, else in-memory rebuilt from MongoDB), "chroma", "memory"
VECTOR_STORE=auto
CHROMA_MODE=persistent         # persistent | ephemeral
CHROMA_PERSIST_DIR=./data/chroma
RETRIEVAL_TOP_K=4
# RETRIEVAL_MIN_SCORE=          # unset = embedder default (0.25 semantic, 0.10 hashing)

# Threshold engine
STALE_READING_MINUTES=120

# Serverless mode is detected automatically on Vercel (VERCEL=1): ingestion runs inside
# the upload request and no background startup thread is used.
# SERVERLESS=false

# Startup behaviour
SEED_ON_STARTUP=false          # seed demo data when the equipment collection is empty
REINDEX_ON_STARTUP=true        # rebuild missing vectors from stored document text
